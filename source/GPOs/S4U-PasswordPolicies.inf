[Unicode]
Unicode=yes
[Version]
signature="$CHICAGO$"
Revision=1
[System Access]
; Password policies that can break S4U autologon must be disabled
; These settings allow KioskUser0 account to have no password

; Disable password complexity requirements
PasswordComplexity = 0

; Set minimum password length to 0 (allows blank passwords)
MinimumPasswordLength = 0

; Set maximum password age to unlimited (99999 days = never expires)
MaximumPasswordAge = 99999

; Set minimum password age to 0 (allows immediate password changes)
MinimumPasswordAge = 0

; Disable password history (not required for kiosk account)
PasswordHistorySize = 0

; Disable account lockout (prevents kiosk account from being locked)
LockoutBadCount = 0
